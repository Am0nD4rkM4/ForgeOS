#!/usr/bin/env bash
# ForgeOS — dos pantallas (laptop + monitor externo), v2.2
# Si hay una segunda pantalla conectada al entrar a i3, manda el espacio 1
# (con el monitor principal, a pantalla completa) a la pantalla de la
# derecha, para trabajar en la laptop y ver los datos en la otra.
# En v2.2 ya NO se crea un segundo monitor: hay un solo monitor, el
# principal del espacio 1, y este script solo lo mueve de pantalla.
# Con una sola pantalla no hace nada.
# Uso: forgeos-pantallas (se ejecuta solo al arrancar i3)
set -euo pipefail
command -v xrandr >/dev/null 2>&1 || exit 0
command -v i3-msg >/dev/null 2>&1 || exit 0
# Solo cuentan las salidas con un modo ACTIVO (resolución + posición,
# p. ej. "1920x1080+0+0"): una salida "connected" sin modo activo es un
# puerto sin nada conectado y NO es una segunda pantalla. Contar también
# esas hacía que el monitor se abriera a pantalla completa con una
# sola pantalla (bug 2026-11-09).
mapfile -t SALIDAS < <(xrandr --query | awk '$2 == "connected" && $0 ~ /[0-9]+x[0-9]+[+]/ {print $1}')
if [[ "${#SALIDAS[@]}" -lt 2 ]]; then
  exit 0
fi
i3-msg "workspace number 1; move workspace to output right" >/dev/null
i3-msg "workspace number 2" >/dev/null
