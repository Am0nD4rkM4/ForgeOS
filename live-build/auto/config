#!/bin/sh
# ForgeOS — live-build config (Debian 13 Trixie, amd64)
set -e
lb config noauto \
  --distribution trixie \
  --architecture amd64 \
  --mode debian \
  --image-name forgeos \
  --iso-volume "ForgeOS 2.0" \
  --iso-application "ForgeOS" \
  --iso-publisher "Tweeky para Luis" \
  --bootappend-live "boot=live components quiet splash" \
  --debian-installer live \
  --debian-installer-gui true \
  --archive-areas "main contrib non-free non-free-firmware" \
  --firmware-binary true \
  --firmware-chroot true \
  --memtest memtest86+ \
  --win32-loader false \
  "${@}"
